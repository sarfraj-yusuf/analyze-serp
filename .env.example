# ==============================================================================
# AnalyzeSERP - Production & Local Environment Variables Configuration
# Copy this file to `.env.local` for local development or set in your hosting platform (e.g. Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NextAuth / Auth.js Configuration (MANDATORY IN PRODUCTION)
# In production, NextAuth will throw HTTP 500 "Server error / Configuration"
# if AUTH_SECRET is not set. Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET="your-generated-random-32-byte-secret"
# Legacy v4 alias (also supported by AnalyzeSERP fallback chain):
NEXTAUTH_SECRET="your-generated-random-32-byte-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://analyzeserp.com"
AUTH_URL="https://analyzeserp.com"

# ------------------------------------------------------------------------------
# 2. OAuth Authentication Providers
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://analyzeserp.com/api/auth/callback/google
# (Aliases GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET also supported)
# ------------------------------------------------------------------------------
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# GitHub Developer Settings: https://github.com/settings/developers
# Authorized callback URL: https://analyzeserp.com/api/auth/callback/github
# (Aliases GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET also supported)
# ------------------------------------------------------------------------------
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# ------------------------------------------------------------------------------
# 3. Database (MySQL / TiDB / PlanetScale / Amazon RDS)
# Required for user audit persistence, saved competitor runs, and user profiles
# ------------------------------------------------------------------------------
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-secure-password"
MYSQL_DATABASE="analyzeserp_db"
# Optional: Enforce TLS/SSL transport encryption for database connections (recommended for cloud databases)
# MYSQL_SSL="true"
# MYSQL_SSL_REJECT_UNAUTHORIZED="true"
# MYSQL_SSL_CA=""

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Engine
# Get API key from: https://aistudio.google.com/app/apikey
# Default model: gemini-2.5-flash or gemini-2.0-flash
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 5. Google PageSpeed Insights & Web Vitals API (Optional)
# Recommended for production high-volume site speed audits without rate-limiting
# Get API key from: https://developers.google.com/speed/docs/insights/v5/get-started
# ------------------------------------------------------------------------------
PAGESPEED_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Admin & Security Secret Keys
# Used to authenticate administrative diagnostic endpoints and feedback retrieval
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY="your-strong-random-admin-secret-key"
# Explicit allowlist of email addresses permitted administrative dashboard privileges (comma-separated)
ADMIN_EMAILS="admin@example.com"
